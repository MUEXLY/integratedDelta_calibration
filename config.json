{
    "calibration_settings":{
        "N_mcmc": 10000,
        "burn_in": 1000,
        "mh_scale_delta_prior": 0.15,
        "theta_initialization":"fixed",
        "posterior_predictive_samples": 200,
        "allow_singular_covariance": true
    },
    "input_settings":{
        "input_delimiter": " ",
        "input_header": true,
        "input_observations_path": "./md-ddd_edgDipole/observationData/",
        "input_model_path": "./md-ddd_edgDipole/modelData/"
    },
    "label_settings":{
        "custom_labels": true,
        "theta_labels":{
                "theta1": "\theta_1",
                "theta2": "\theta_2"

        },
        "kappa_labels":{
                "kappa1": "kappa_1",
                "kappa2": "kappa_2"
        },
        "observation_labels":{
                "obs1": "y"
        },
        "observation_set_label": "Synthetic Observation",
        "simulation_set_label": "Synthetic Simulation",
        "application_domain_labels":{
                "domain1": "x"
        }

    },
    "cross_validation_settings":{
        "conduct_cross_validation": true,
        "known_theta_form": "constant",
        "known_theta_form_params": {
            "constant": {
                "values": [1.0,1.0]
            },
            "trig_funct": {
                "functions": ["sin", "cos"]
            }
        }
    },
    "output_settings":{
        "figures_path": "figures/",
        "figure_options":{
            "data_priors": true,
            "radar_plot": true,
            "radar_animation": true,
            "posterior_predict_normalized": true,
            "posterior_predict_physical": true,
            "delta_posterior_normalized": true,
            "delta_posterior_physical": true,
            "prior_posterior_density": true,
            "holdout_sensitivity": true,
            "holdout_predictions": true,
            "holdout_nrmse_sensitivity": true,
            "acceptance_trajectory": true,
            "step_size_plot": true
        },
        "results_options":{
            "results_path": "results/",
            "save_calibrated_parameters": true,
            "save_model_csv": true,
            "save_model_json": true
        },
        "validation_options": {
            "holdout_fractions": [0.1, 0.2, 0.3],
            "holdout_repeats": 20,
            "random_seed": 0,
            "holdout_predictions_filename": "holdout_predictions.png",
            "holdout_nrmse_filename": "holdout_nrmse_sensitivity.png"
        }
    }
}